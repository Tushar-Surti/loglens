# ─────────────────────────────────────────────────────────────────────────────
# LogLens — environment configuration
# Copy to `.env` and adjust. Every service reads from this single file.
# ─────────────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=loglens

# ── Kafka ────────────────────────────────────────────────────────────────────
# Inside docker network use kafka:9092 ; from the host use localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092
KAFKA_TOPIC_RAW=weblogs.raw
KAFKA_TOPIC_ENRICHED=weblogs.enriched
KAFKA_TOPIC_ANOMALIES=weblogs.anomalies
KAFKA_TOPIC_ALERTS=weblogs.alerts
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_PRODUCER_LINGER_MS=25
KAFKA_PRODUCER_BATCH_SIZE=65536
KAFKA_PRODUCER_COMPRESSION=lz4

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
MONGO_URI_HOST=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=loglens
# Time-to-live for raw log documents, in seconds (default 24h)
MONGO_RAW_TTL_SECONDS=86400
MONGO_METRIC_TTL_SECONDS=1209600

# ── Spark ────────────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_APP_NAME=loglens-streaming
SPARK_SHUFFLE_PARTITIONS=8
SPARK_CHECKPOINT_DIR=/opt/loglens/checkpoints
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_WATERMARK_DELAY=2 minutes
SPARK_MAX_OFFSETS_PER_TRIGGER=60000
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# ── Windowing ────────────────────────────────────────────────────────────────
WINDOW_METRIC=1 minute
WINDOW_GEO=5 minutes
SESSION_GAP=15 minutes

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
API_LOG_LEVEL=INFO
API_WS_TICK_SECONDS=3

# ── Generator ────────────────────────────────────────────────────────────────
GEN_BASE_RPS=180
GEN_SEED=1337
GEN_SCENARIOS=true
GEN_SERVICES=web-storefront,api-gateway,checkout-svc,search-svc,media-cdn
GEN_SPEED=1.0

# ── ML ───────────────────────────────────────────────────────────────────────
MODEL_DIR=/opt/loglens/models
MODEL_RETRAIN_INTERVAL_MINUTES=60
ML_MIN_TRAINING_ROWS=240

# ── Detection thresholds (runtime-overridable from the Settings page) ────────
DET_ZSCORE_THRESHOLD=3.5
DET_EWMA_ALPHA=0.25
DET_ERROR_RATE_THRESHOLD=0.08
DET_LATENCY_P95_MULTIPLIER=2.5
DET_IP_RPS_THRESHOLD=25
DET_SCAN_UNIQUE_PATHS=30
DET_AUTH_FAIL_THRESHOLD=15
DET_ISOFOREST_CONTAMINATION=0.02
DET_SEVERITY_CRITICAL=85
DET_SEVERITY_HIGH=70
DET_SEVERITY_MEDIUM=50
DET_SEVERITY_LOW=30

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CORRELATION_INTERVAL_SECONDS=20
WORKER_INCIDENT_JOIN_WINDOW_MINUTES=10
WORKER_HEALTH_INTERVAL_SECONDS=15

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# ── Grafana ──────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=loglens
